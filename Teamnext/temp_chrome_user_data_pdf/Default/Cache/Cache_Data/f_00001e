                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        async function applyLeave() {
            const type = document.getElementById('l-type').value;
            const start = document.getElementById('l-start').value;
            const end = document.getElementById('l-end').value;
            const reason = document.getElementById('l-reason').value;

            if (!start || !end || !reason) return alert("Please fill all required fields");

            try {
                const res = await fetch('/api/leaves/apply/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ type, start_date: start, end_date: end, reason })
                });
                const d = await res.json();
                if (d.status === 'ok') {
                    alert('Leave request submitted successfully!');
                    location.reload();
                } else {
                    alert('Error: ' + d.message);
                }
            } catch (e) {
                alert('Request failed. Please try again.');
            }
        }

        async function actionLeave(id, action) {
            if (!confirm('Are you sure you want to ' + action + ' this leave request?')) return;
            try {
                const res = await fetch('/api/leaves/action/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ leave_id: id, action: action })
                });
                const d = await res.json();
                if (d.status === 'ok') {
                    location.reload();
                } else {
                    alert('Error: ' + d.message);
                }
            } catch (e) {
                alert('Action failed. Please try again.');
            }
        }
    </script>
</body>

</html>