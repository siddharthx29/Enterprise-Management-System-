    <!-- Pure Vanilla JS (< 2KB memory footprint) -->
    <script>
        // 1. Inline Card Zoom Toggle
        let isCardZoomed = false;
        function toggleCardZoom(btn) {
            const card = document.getElementById('profileHeroPanel');
            const label = document.getElementById('zoomToggleLabel');
            isCardZoomed = !isCardZoomed;
            if (isCardZoomed) {
                card.classList.add('glass-zoomed');
                if (label) label.textContent = 'Reset Zoom';
            } else {
                card.classList.remove('glass-zoomed');
                if (label) label.textContent = 'Zoom In';
            }
        }

        // 2. Glassmorphic Modal Zoom
        function openGlassZoomModal() {
            const overlay = document.getElementById('glassZoomOverlay');
            if (overlay) overlay.classList.add('active');
        }

        function closeGlassZoomModal() {
            const overlay = document.getElementById('glassZoomOverlay');
            if (overlay) overlay.classList.remove('active');
        }

        function handleBackdropClick(e) {
            if (e.target.id === 'glassZoomOverlay') {
                closeGlassZoomModal();
            }
        }

        // Keyboard Shortcut: Escape to close modal, Z to toggle zoom
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeGlassZoomModal();
                if (isCardZoomed) {
                    const card = document.getElementById('profileHeroPanel');
                    const label = document.getElementById('zoomToggleLabel');
                    if (card) card.classList.remove('glass-zoomed');
                    if (label) label.textContent = 'Zoom In';
                    isCardZoomed = false;
                }
            }
        });

        // 3. Copy Email to Clipboard
        function copyEmail() {
            const email = "admin@teamnext.com";
            if (navigator.clipboard && email) {
                navigator.clipboard.writeText(email).then(() => {
                    const confirmEl = document.getElementById('copyConfirm');
                    if (confirmEl) {
                        confirmEl.style.display = 'inline';
                        setTimeout(() => { confirmEl.style.display = 'none'; }, 2000);
                    }
                });
            }
        }

        // 4. In-Place Profile Save
        async function saveProfileChanges(e) {
            e.preventDefault();
            const btn = document.getElementById('saveProfileBtn');
            const status = document.getElementById('profileStatusMsg');
            const nameInput = document.getElementById('editNameInput');
            const phoneInput = document.getElementById('editPhoneInput');

            const name = nameInput.value.trim();
            const phone = phoneInput.value.trim();

            if (!name) return;

            btn.disabled = true;
            btn.style.opacity = '0.7';
            status.style.color = 'var(--text-muted)';
            status.textContent = 'Saving changes...';

            try {
                const res = await fetch('/api/profile/update/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: name, phone: phone })
                });
                const data = await res.json();
                if (data.status === 'success') {
                    status.style.color = '#10B981';
                    status.textContent = '✓ Profile updated successfully!';
                    document.getElementById('profileDisplayName').textContent = data.name;
                    document.getElementById('zoomModalName').textContent = data.name;
                    if (document.getElementById('profilePhoneVal')) {
                        document.getElementById('profilePhoneVal').textContent = data.phone || 'Not Configured';
                    }
                } else {
                    status.style.color = '#EF4444';
                    status.textContent = data.message || 'Failed to update profile';
                }
            } catch (err) {
                status.style.color = '#EF4444';
                status.textContent = 'Network error while saving profile';
            } finally {
                btn.disabled = false;
                btn.style.opacity = '1';
                setTimeout(() => {
                    if (status.textContent.includes('✓')) {
                        status.textContent = '';
                    }
                }, 3500);
            }
        }
    </script>
