                    From / To: <strong id="modalFrom" style="color: var(--text-primary);">sender@example.com</strong>
                </div>
                <div id="modalBody" style="background: #FAFBFD; padding: 14px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 13px; line-height: 1.5; white-space: pre-wrap; max-height: 300px; overflow-y: auto;">
                    Email content...
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal()">Close</button>
            </div>
        </div>
    </div>

    <script>
        const sendBtn = document.getElementById('sendBtn');
        const saveBtn = document.getElementById('saveBtn');
        const status = document.getElementById('status');
        const inboxList = document.getElementById('inboxList');

        document.addEventListener('DOMContentLoaded', async () => {
            try {
                const res = await fetch('/api/email/fetch/');
                const data = await res.json();
                if (data.status === 'ok' && data.emails && data.emails.length > 0) {
                    renderAsyncEmails(data.emails);
                }
            } catch (e) {
                console.error(e);
            }
        });

        function renderAsyncEmails(list) {
            if (!inboxList) return;
            const existingText = inboxList.innerText.trim();
            if (existingText.includes('No inbox messages')) {
                inboxList.innerHTML = '';
            }

            list.forEach(m => {
                const el = document.createElement('div');
                el.className = 'mail-card';
                el.style.borderLeft = '3px solid var(--primary-accent)';
                el.innerHTML = `
                    <div onclick="openEmailObj(this)">
                        <div style="display:flex; justify-content:space-between; margin-bottom:2px">
                            <strong class="em-subj" style="font-size:13px; color:var(--text-primary);">${escapeHtml(m.subject || '(No Subject)')}</strong>
                            <span class="em-from" style="font-size:11px; color:var(--text-muted);">${escapeHtml(m.from)}</span>
                        </div>
                        <div style="font-size:12px; color:var(--text-secondary); line-height:1.4;">${escapeHtml(m.body || '').slice(0, 90)}...</div>
                        <div class="em-body" style="display:none;">${escapeHtml(m.body || '')}</div>
                    </div>
                `;
                inboxList.prepend(el);
            });
        }

        function escapeHtml(text) {
            if (!text) return '';
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        function openEmailObj(el) {
            const subj = el.querySelector('.em-subj') ? el.querySelector('.em-subj').innerText : 'Message';
            const from = el.querySelector('.em-from') ? el.querySelector('.em-from').innerText : '';
            const body = el.querySelector('.em-body') ? el.querySelector('.em-body').innerText : '';

            document.getElementById('modalSubject').innerText = subj;
            document.getElementById('modalFrom').innerText = from;
            document.getElementById('modalBody').innerText = body;

            document.getElementById('emailModal').classList.add('active');
        }

        function closeModal() {
            document.getElementById('emailModal').classList.remove('active');
        }

        sendBtn.addEventListener('click', async () => {
            const to = document.getElementById('to').value.trim();
            const subject = document.getElementById('subject').value.trim();
            const body = document.getElementById('body').value.trim();
            if (!to || !subject || !body) {
                status.textContent = 'All fields required';
                status.style.color = 'var(--danger-red)';
                return;
            }
            sendBtn.disabled = true;
            status.textContent = 'Sending...';
            status.style.color = 'var(--text-muted)';
            try {
                const res = await fetch('/dashboard/send-email/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ to, subject, body })
                });
                const data = await res.json();
                if (data.status === 'success' || data.status === 'ok') {
                    status.textContent = 'Email sent successfully!';
                    status.style.color = 'var(--success-green)';
                    document.getElementById('to').value = '';
                    document.getElementById('subject').value = '';
                    document.getElementById('body').value = '';
                    setTimeout(() => location.reload(), 700);
                } else {
                    status.textContent = data.message || 'Failed';
                    status.style.color = 'var(--danger-red)';
                    sendBtn.disabled = false;
                }
            } catch (e) {
                status.textContent = 'Error sending email';
                status.style.color = 'var(--danger-red)';
                sendBtn.disabled = false;
            }
        });

        saveBtn.addEventListener('click', async () => {
            const to = document.getElementById('to').value.trim();
            const subject = document.getElementById('subject').value.trim();
            const body = document.getElementById('body').value.trim();

            if (!to && !subject && !body) {
                status.textContent = 'Enter email details to save draft';
                status.style.color = 'var(--danger-red)';
                return;
            }

            try {
                const res = await fetch('/email-page/save-draft/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'save', to, subject, body })
                });
                const d = await res.json();
                if (d.status === 'ok') {
                    status.textContent = 'Draft saved';
                    status.style.color = 'var(--success-green)';
                    setTimeout(() => location.reload(), 600);
                } else {
                    status.textContent = d.message || 'Failed to save draft';
                    status.style.color = 'var(--danger-red)';
                }
            } catch (e) {
                status.textContent = 'Connection error';
                status.style.color = 'var(--danger-red)';
            }
        });

        document.addEventListener('click', async function (e) {
            if (e.target.classList.contains('loadDraftBtn')) {
                const to = e.target.getAttribute('data-to') || '';
                const subj = e.target.getAttribute('data-subject') || '';
                const body = e.target.getAttribute('data-body') || '';

                document.getElementById('to').value = to;
                document.getElementById('subject').value = subj;
                document.getElementById('body').value = body;
                status.textContent = 'Draft loaded into composer';
                status.style.color = 'var(--success-green)';
                window.scrollTo({ top: 0, behavior: 'smooth' });
                return;
            }

            if (e.target.classList.contains('delDraftBtn')) {
                const draftId = e.target.getAttribute('data-id');
                if (!draftId) return;

                try {
                    const res = await fetch('/email-page/save-draft/', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'delete', id: draftId })
                    });
                    const d = await res.json();
                    if (d.status === 'ok') {
                        const card = document.getElementById(`draft-item-${draftId}`) || e.target.closest('.mail-card');
                        if (card) card.remove();
                    } else {
                        alert(d.message || 'Delete failed');
                    }
                } catch (err) {
                    alert('Connection error');
                }
            }
        });
    </script>
</body>

</html>