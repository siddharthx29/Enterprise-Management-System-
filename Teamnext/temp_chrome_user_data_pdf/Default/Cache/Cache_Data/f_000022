                    <div id="genStatus" style="margin-top: 10px; text-align: center; font-size: 12px; min-height: 16px;"></div>
                </div>
            </div>

            <!-- Recent Downloads Panel -->
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title">Recent Document Exports</span>
                </div>
                <div class="panel-body">
                    <div id="downloadsContainer" style="display: flex; flex-direction: column; gap: 8px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: #FAFBFD; border-radius: 6px; border: 1px solid var(--border-subtle);">
                            <span style="font-size: 12px; font-weight: 500; color: var(--text-primary);">Q4_Quarterly_Review.pdf</span>
                            <span style="font-size: 11px; color: var(--text-muted);">2 hours ago</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: #FAFBFD; border-radius: 6px; border: 1px solid var(--border-subtle);">
                            <span style="font-size: 12px; font-weight: 500; color: var(--text-primary);">Department_Structure_Export.csv</span>
                            <span style="font-size: 11px; color: var(--text-muted);">Yesterday</span>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        async function generateReport(type, format) {
            const status = document.getElementById('genStatus');
            const btns = document.querySelectorAll('.report-item button');

            btns.forEach(b => b.disabled = true);
            status.textContent = `Generating ${type} report (${format.toUpperCase()})...`;
            status.style.color = 'var(--primary-accent)';

            try {
                const res = await fetch('/api/reports/generate/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ report_type: type, format: format })
                });
                const data = await res.json();

                if (data.status === 'ok' && data.file_data) {
                    status.textContent = 'Report ready, downloading...';
                    status.style.color = 'var(--success-green)';

                    const ext = format === 'pdf' ? 'pdf' : 'xlsx';
                    const fileName = `${type}_Report_${new Date().toISOString().split('T')[0]}.${ext}`;

                    const binaryData = atob(data.file_data);
                    const array = new Uint8Array(binaryData.length);
                    for (let i = 0; i < binaryData.length; i++) {
                        array[i] = binaryData.charCodeAt(i);
                    }

                    const blob = new Blob([array], { type: data.content_type });
                    const link = document.createElement("a");
                    link.href = URL.createObjectURL(blob);
                    link.download = fileName;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);

                    const downloads = document.getElementById('downloadsContainer');
                    if (downloads) {
                        const newDownload = document.createElement('div');
                        newDownload.style = "display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: #FAFBFD; border-radius: 6px; border: 1px solid var(--border-subtle);";
                        newDownload.innerHTML = `
                            <span style="font-size: 12px; font-weight: 500; color: var(--text-primary);">${fileName}</span>
                            <span style="font-size: 11px; color: var(--text-muted);">Just now</span>
                        `;
                        downloads.prepend(newDownload);
                    }
                } else {
                    status.textContent = data.message || 'Error generating report';
                    status.style.color = 'var(--danger-red)';
                }
            } catch (e) {
                status.textContent = 'Connection error. Please try again.';
                status.style.color = 'var(--danger-red)';
            } finally {
                setTimeout(() => {
                    btns.forEach(b => b.disabled = false);
                }, 2000);
            }
        }
    </script>
</body>

</html>