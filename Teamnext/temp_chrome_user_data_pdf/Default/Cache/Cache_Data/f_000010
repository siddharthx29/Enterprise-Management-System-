                <!-- Tab 3: Records History -->
                <div id="records-tab" class="tab-content">
                    <div style="display: flex; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; align-items: flex-end;">
                        <div style="flex: 1; min-width: 160px;">
                            <label>Filter Employee</label>
                            <select id="filter-employee-select" onchange="loadAttendanceRecords()">
                                <option value="">All Personnel</option>
                            </select>
                        </div>
                        <div style="flex: 1; min-width: 140px;">
                            <label>From Date</label>
                            <input type="date" id="from-date" onchange="loadAttendanceRecords()">
                        </div>
                        <div style="flex: 1; min-width: 140px;">
                            <label>To Date</label>
                            <input type="date" id="to-date" onchange="loadAttendanceRecords()">
                        </div>
                        <div style="flex: 1; min-width: 140px;">
                            <label>Status</label>
                            <select id="filter-status-select" onchange="loadAttendanceRecords()">
                                <option value="">All Statuses</option>
                                <option value="present">Present</option>
                                <option value="absent">Absent</option>
                                <option value="late">Late</option>
                            </select>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Employee</th>
                                    <th>Check In</th>
                                    <th>Check Out</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody id="records-list">
                                <tr>
                                    <td colspan="5" style="text-align: center; padding: 24px; color: var(--text-muted);">
                                        Select date range to view records.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal: Add Employee -->
    <div id="add-employee-modal" class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <span class="modal-title">Register New Employee</span>
                <button type="button" class="btn btn-ghost btn-sm" onclick="closeAddEmployeeModal()">✕</button>
            </div>
            <form id="add-employee-form" onsubmit="addEmployee(event)">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Full Name *</label>
                        <input type="text" name="name" required placeholder="e.g. John Doe">
                    </div>
                    <div class="form-group">
                        <label>Work Email *</label>
                        <input type="email" name="email" required placeholder="john.doe@company.com">
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Designation / Role *</label>
                            <input type="text" name="role" required placeholder="e.g. Senior Accountant">
                        </div>
                        <div class="form-group">
                            <label>Contact Phone</label>
                            <input type="tel" name="phone" placeholder="+1 555-0199">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Department</label>
                        <select name="department_id" id="modal-department-select">
                            <option value="">-- Unassigned --</option>
                            
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" onclick="closeAddEmployeeModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Employee</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal: Mark Attendance -->
    <div id="mark-attendance-modal" class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <span class="modal-title">Log Attendance Record</span>
                <button type="button" class="btn btn-ghost btn-sm" onclick="closeMarkAttendanceModal()">✕</button>
            </div>
            <form id="mark-attendance-form" onsubmit="markAttendance(event)">
                <div class="modal-body">
                    <input type="hidden" name="employee_id" id="attendance-employee-id">
                    <input type="hidden" name="mode" id="attendance-mode" value="checkin">

                    <div class="form-group">
                        <label>Employee Name</label>
                        <input type="text" id="attendance-employee-name" readonly style="background: #F8FAFC; color: var(--text-secondary);">
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Date</label>
                            <input type="date" name="date" id="attendance-date" required>
                        </div>
                        <div class="form-group">
                            <label>Attendance Status</label>
                            <select name="status" id="attendance-status">
                                <option value="present">Present</option>
                                <option value="absent">Absent</option>
                                <option value="late">Late Arrival</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group" id="checkin-group">
                            <label>Check In Time</label>
                            <input type="time" name="check_in" id="attendance-checkin">
                        </div>
                        <div class="form-group" id="checkout-group">
                            <label>Check Out Time</label>
                            <input type="time" name="check_out" id="attendance-checkout">
                        </div>
                    </div>
                    <div id="checkout-hint" style="font-size: 11px; color: var(--text-muted); display: flex; align-items: center; gap: 4px;">
                        ℹ Check-out time activates after check-in is submitted.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" onclick="closeMarkAttendanceModal()">Cancel</button>
                    <button type="submit" id="attendance-submit-btn" class="btn btn-primary">Save Attendance</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let currentTab = 'employees';

        function switchTab(tab) {
            currentTab = tab;
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

            if (tab === 'employees') {
                document.querySelectorAll('.tab')[0].classList.add('active');
                document.getElementById('employees-tab').classList.add('active');
                loadEmployees();
            } else if (tab === 'attendance') {
                document.querySelectorAll('.tab')[1].classList.add('active');
                document.getElementById('attendance-tab').classList.add('active');
                loadAttendanceTracker();
            } else if (tab === 'records') {
                document.querySelectorAll('.tab')[2].classList.add('active');
                document.getElementById('records-tab').classList.add('active');
                loadAttendanceRecords();
            }
        }

        async function loadEmployees() {
            try {
                const response = await fetch('/api/hr/employees/');
                const data = await response.json();
                const tbody = document.getElementById('employees-list');
                const filterSelect = document.getElementById('filter-employee-select');

                if (data.status === 'ok' && data.employees) {
                    if (data.employees.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:24px; color:var(--text-muted);">No employees registered yet.</td></tr>';
                        return;
                    }

                    filterSelect.innerHTML = '<option value="">All Personnel</option>' +
                        data.employees.map(e => `<option value="${e.id}">${e.name}</option>`).join('');

                    tbody.innerHTML = data.employees.map(emp => {
                        let badgeClass = 'badge-gray';
                        let statusText = emp.attendance_status || 'Not Checked In';
                        if (emp.attendance_status === 'present') badgeClass = 'badge-green';
                        else if (emp.attendance_status === 'absent') badgeClass = 'badge-red';
                        else if (emp.attendance_status === 'late') badgeClass = 'badge-amber';

                        return `
                            <tr>
                                <td style="font-weight:600; color:var(--text-primary);">${emp.name}</td>
                                <td>${emp.email}</td>
                                <td>${emp.role || '-'}</td>
                                <td>${emp.department_name || '-'}</td>
                                <td>${emp.phone || '-'}</td>
                                <td><span class="badge ${badgeClass}">${statusText}</span></td>
                                <td>
                                    <button class="btn btn-ghost btn-sm" onclick="openMarkAttendanceModal(${emp.id}, '${emp.name.replace(/'/g, "\\'")}', '${emp.check_in || ''}', '${emp.check_out || ''}', '${emp.check_in ? 'checkout' : 'checkin'}')">
                                        ${emp.check_in && !emp.check_out ? 'Check Out' : 'Mark'}
                                    </button>
                                </td>
                            </tr>
                        `;
                    }).join('');
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function loadAttendanceTracker() {
            const dateInput = document.getElementById('attendance-tracker-date');
            if (!dateInput.value) {
                dateInput.value = new Date().toISOString().split('T')[0];
            }
            const date = dateInput.value;

            try {
                const response = await fetch(`/api/hr/attendance-tracker/?date=${date}`);
                const data = await response.json();
                const tbody = document.getElementById('attendance-tracker-list');

                if (data.status === 'ok' && data.records) {
                    if (data.records.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:24px; color:var(--text-muted);">No records found for this date.</td></tr>';
                        return;
                    }

                    tbody.innerHTML = data.records.map(rec => {
                        let badgeClass = 'badge-gray';
                        if (rec.status === 'present') badgeClass = 'badge-green';
                        else if (rec.status === 'absent') badgeClass = 'badge-red';
                        else if (rec.status === 'late') badgeClass = 'badge-amber';

                        return `
                            <tr>
                                <td style="font-weight:600;">${rec.employee_name}</td>
                                <td>${rec.check_in || '--:--'}</td>
                                <td>${rec.check_out || '--:--'}</td>
                                <td><span class="badge ${badgeClass}">${rec.status || 'Pending'}</span></td>
                                <td>
                                    <button class="btn btn-ghost btn-sm" onclick="openMarkAttendanceModal(${rec.employee_id}, '${rec.employee_name.replace(/'/g, "\\'")}', '${rec.check_in || ''}', '${rec.check_out || ''}', '${rec.check_in ? 'checkout' : 'checkin'}')">
                                        Update
                                    </button>
                                </td>
                            </tr>
                        `;
                    }).join('');
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function loadAttendanceRecords() {
            const empId = document.getElementById('filter-employee-select').value;
            const fromDate = document.getElementById('from-date').value;
            const toDate = document.getElementById('to-date').value;
            const status = document.getElementById('filter-status-select').value;

            const params = new URLSearchParams();
            if (empId) params.append('employee_id', empId);
            if (fromDate) params.append('from_date', fromDate);
            if (toDate) params.append('to_date', toDate);
            if (status) params.append('status', status);

            try {
                const response = await fetch(`/api/hr/attendance-records/?${params.toString()}`);
                const data = await response.json();
                const tbody = document.getElementById('records-list');

                if (data.status === 'ok' && data.records) {
                    if (data.records.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:24px; color:var(--text-muted);">No records found matching filters.</td></tr>';
                        return;
                    }

                    tbody.innerHTML = data.records.map(rec => {
                        let badgeClass = 'badge-gray';
                        if (rec.status === 'present') badgeClass = 'badge-green';
                        else if (rec.status === 'absent') badgeClass = 'badge-red';
                        else if (rec.status === 'late') badgeClass = 'badge-amber';

                        return `
                            <tr>
                                <td>${rec.date}</td>
                                <td style="font-weight:600;">${rec.employee_name}</td>
                                <td>${rec.check_in || '--:--'}</td>
                                <td>${rec.check_out || '--:--'}</td>
                                <td><span class="badge ${badgeClass}">${rec.status}</span></td>
                            </tr>
                        `;
                    }).join('');
                }
            } catch (err) {
                console.error(err);
            }
        }

        function openAddEmployeeModal() {
            document.getElementById('add-employee-modal').classList.add('active');
        }

        function closeAddEmployeeModal() {
            document.getElementById('add-employee-modal').classList.remove('active');
            document.getElementById('add-employee-form').reset();
        }

        function openMarkAttendanceModal(employeeId, employeeName, existingCheckIn, existingCheckOut, mode) {
            const checkInField = document.getElementById('attendance-checkin');
            const checkOutField = document.getElementById('attendance-checkout');
            const checkoutHint = document.getElementById('checkout-hint');
            const submitBtn = document.getElementById('attendance-submit-btn');
            const modeField = document.getElementById('attendance-mode');
            const statusField = document.getElementById('attendance-status');

            document.getElementById('mark-attendance-form').reset();
            document.getElementById('attendance-employee-id').value = employeeId;
            document.getElementById('attendance-employee-name').value = employeeName;
            document.getElementById('attendance-date').value = new Date().toISOString().split('T')[0];

            if (mode === 'checkout' && existingCheckIn) {
                modeField.value = 'checkout';
                checkInField.value = existingCheckIn;
                checkInField.readOnly = true;
                checkOutField.disabled = false;
                checkoutHint.style.display = 'none';
                checkOutField.value = new Date().toTimeString().slice(0, 5);
                submitBtn.textContent = 'Log Check Out';
                statusField.value = 'present';
            } else {
                modeField.value = 'checkin';
                checkInField.readOnly = false;
                checkOutField.disabled = true;
                checkoutHint.style.display = 'flex';
                checkInField.value = new Date().toTimeString().slice(0, 5);
                submitBtn.textContent = 'Log Check In';
                statusField.value = 'present';
            }

            checkInField.onchange = function () {
                if (this.value) {
                    checkOutField.disabled = false;
                    checkoutHint.style.display = 'none';
                } else {
                    checkOutField.disabled = true;
                    checkOutField.value = '';
                    checkoutHint.style.display = 'flex';
                }
            };

            document.getElementById('mark-attendance-modal').classList.add('active');
        }

        function closeMarkAttendanceModal() {
            document.getElementById('mark-attendance-modal').classList.remove('active');
            document.getElementById('mark-attendance-form').reset();
        }

        async function addEmployee(event) {
            event.preventDefault();
            const formData = new FormData(event.target);
            const deptVal = formData.get('department_id');
            const data = {
                name: formData.get('name'),
                email: formData.get('email'),
                role: formData.get('role'),
                phone: formData.get('phone'),
                department_id: deptVal ? parseInt(deptVal) : null
            };

            try {
                const response = await fetch('/api/hr/add-employee/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.status === 'ok') {
                    alert(result.message);
                    closeAddEmployeeModal();
                    loadEmployees();
                    updateStats();
                } else {
                    alert('Error: ' + result.message);
                }
            } catch (err) {
                alert('Error adding employee');
            }
        }

        async function markAttendance(event) {
            event.preventDefault();
            const formData = new FormData(event.target);
            const data = {
                employee_id: formData.get('employee_id'),
                date: formData.get('date'),
                status: formData.get('status'),
                check_in: formData.get('check_in'),
                check_out: formData.get('check_out')
            };

            try {
                const response = await fetch('/api/hr/mark-attendance/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.status === 'ok') {
                    alert(result.message);
                    closeMarkAttendanceModal();
                    if (currentTab === 'attendance') loadAttendanceTracker();
                    else loadEmployees();
                    updateStats();
                } else {
                    alert('Error: ' + result.message);
                }
            } catch (err) {
                alert('Error marking attendance');
            }
        }

        async function updateStats() {
            try {
                const response = await fetch('/api/hr/employees/');
                const data = await response.json();
                if (data.status === 'ok') {
                    const presentToday = data.employees.filter(e => e.attendance_status === 'present').length;
                    document.getElementById('total-employees').textContent = data.employees.length;
                    document.getElementById('present-today').textContent = presentToday;
                }
            } catch (e) { }
        }

        // Set default date filter (last 7 days)
        const today = new Date();
        const weekAgo = new Date(today);
        weekAgo.setDate(weekAgo.getDate() - 7);
        const toDateEl = document.getElementById('to-date');
        const fromDateEl = document.getElementById('from-date');
        if (toDateEl) toDateEl.value = today.toISOString().split('T')[0];
        if (fromDateEl) fromDateEl.value = weekAgo.toISOString().split('T')[0];

        // Init
        loadEmployees();
    </script>
</body>

</html>