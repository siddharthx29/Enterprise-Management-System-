    <script>
        async function refreshDevelopers() {
            try {
                const res = await fetch('/api/developers/');
                const data = await res.json();
                if (data.status === 'ok' && data.developers.length > 0) {
                    const sel = document.getElementById('assigneeSel');
                    if (!sel) return;

                    const selectedValue = sel.value;
                    sel.innerHTML = '<option value="">-- Unassigned --</option>';

                    data.developers.forEach(d => {
                        const opt = document.createElement('option');
                        opt.value = d.email;
                        opt.textContent = d.name;
                        sel.appendChild(opt);
                    });

                    if (selectedValue) sel.value = selectedValue;
                }
            } catch (e) {
                console.error('Error loading employees:', e);
            }
        }

        document.getElementById('createBtn').addEventListener('click', async function () {
            const title = document.getElementById('tTitle').value.trim();
            const desc = document.getElementById('tDesc').value.trim();
            const proj = document.getElementById('projSel').value;
            const priority = document.getElementById('prioritySel').value;
            const assignee = document.getElementById('assigneeSel').value;
            const status = document.getElementById('status');

            if (!title || !desc) {
                status.textContent = 'Title and description required';
                status.style.color = 'var(--danger-red)';
                return;
            }
            status.textContent = 'Creating ticket...';
            status.style.color = 'var(--text-muted)';
            try {
                const res = await fetch('/dashboard/create-ticket/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, description: desc, project_id: proj, priority, assignee })
                });
                const data = await res.json();
                if (data.status === 'success') {
                    status.textContent = 'Ticket created successfully!';
                    status.style.color = 'var(--success-green)';
                    setTimeout(() => location.reload(), 800);
                } else {
                    status.textContent = data.message || 'Failed';
                    status.style.color = 'var(--danger-red)';
                }
            } catch (e) {
                status.textContent = 'Error creating ticket';
                status.style.color = 'var(--danger-red)';
            }
        });

        document.getElementById('reqOtpBtn').addEventListener('click', async function () {
            const name = document.getElementById('devName').value.trim();
            const email = document.getElementById('devEmail').value.trim();
            const st = document.getElementById('devStatus');
            if (!name || !email) {
                st.textContent = 'Name and email required';
                st.style.color = 'var(--danger-red)';
                return;
            }
            st.textContent = 'Requesting OTP...';
            st.style.color = 'var(--text-muted)';
            try {
                const res = await fetch('/api/add-developer/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, email })
                });
                const data = await res.json();
                if (data.status === 'ok') {
                    st.textContent = 'OTP sent to ' + email;
                    st.style.color = 'var(--success-green)';
                } else {
                    st.textContent = data.message || 'Failed';
                    st.style.color = 'var(--danger-red)';
                }
            } catch (e) {
                st.textContent = 'Error';
                st.style.color = 'var(--danger-red)';
            }
        });

        document.getElementById('verifyOtpBtn').addEventListener('click', async function () {
            const otp = document.getElementById('devOtp').value.trim();
            const st = document.getElementById('devStatus');
            if (!otp) {
                st.textContent = 'Enter OTP code';
                st.style.color = 'var(--danger-red)';
                return;
            }
            st.textContent = 'Verifying...';
            st.style.color = 'var(--text-muted)';
            try {
                const res = await fetch('/api/verify-developer/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ otp })
                });
                const data = await res.json();
                if (data.status === 'ok') {
                    st.textContent = 'Developer added: ' + data.developer;
                    st.style.color = 'var(--success-green)';
                    await refreshDevelopers();
                } else {
                    st.textContent = data.message || 'Failed';
                    st.style.color = 'var(--danger-red)';
                }
            } catch (e) {
                st.textContent = 'Error verifying OTP';
                st.style.color = 'var(--danger-red)';
            }
        });

        refreshDevelopers();
    </script>
