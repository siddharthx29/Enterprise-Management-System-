                channelTitle.textContent = '# ' + pName;
            }
            updateHeaderLockState();
            loadMessages();
        }

        async function loadMessages() {
            if (!currentProjectId) {
                if (chatArea) chatArea.innerHTML = '<div style="text-align:center; padding:30px; color:var(--text-muted); font-size:12px;">No active channels. Create a project first.</div>';
                return;
            }

            try {
                const res = await fetch(`/api/chat/messages/?project=${encodeURIComponent(currentProjectId)}`);
                const data = await res.json();

                if (data.status === 'locked') {
                    currentProjectIsLocked = true;
                    currentProjectIsUnlocked = false;
                    updateHeaderLockState();
                    renderLockedChannelBanner();
                    return;
                }

                if (data.status === 'ok') {
                    currentProjectIsLocked = !!data.is_locked;
                    currentProjectIsUnlocked = !!data.is_unlocked;
                    updateHeaderLockState();

                    if (!data.messages || data.messages.length === 0) {
                        chatArea.innerHTML = '<div style="text-align:center; padding:40px; color:var(--text-muted); font-size:12px;">No messages in this channel yet. Start the conversation or share a file!</div>';
                        return;
                    }

                    chatArea.innerHTML = data.messages.map(m => {
                        const isSelf = (m.email || '').toLowerCase() === currentUserEmail;
                        const timeDisplay = formatTime(m.time);

                        let mediaHtml = '';
                        if (m.media && m.media.length > 0) {
                            mediaHtml = `<div class="msg-media-grid">` + m.media.map(med => {
                                if (med.is_image) {
                                    return `
                                        <div class="media-img-wrapper" onclick="openLightbox('${med.url}', '${escapeHtml(med.filename)}')">
                                            <img src="${med.url}" alt="${escapeHtml(med.filename)}" class="media-img-preview" loading="lazy">
                                        </div>
                                    `;
                                } else if (med.is_video) {
                                    return `
                                        <video controls class="media-video-player" preload="metadata">
                                            <source src="${med.url}" type="${med.content_type || 'video/mp4'}">
                                            Your browser does not support the video tag.
                                        </video>
                                    `;
                                } else if (med.is_audio) {
                                    return `
                                        <audio controls class="media-audio-player" preload="metadata">
                                            <source src="${med.url}" type="${med.content_type || 'audio/mpeg'}">
                                            Your browser does not support the audio tag.
                                        </audio>
                                    `;
                                } else {
                                    return `
                                        <div class="bubble-doc-card">
                                            <span class="bubble-doc-icon">📄</span>
                                            <div class="bubble-doc-details">
                                                <div class="bubble-doc-name" title="${escapeHtml(med.filename)}">${escapeHtml(med.filename)}</div>
                                                <div class="bubble-doc-size">${med.formatted_size || ''}</div>
                                            </div>
                                            <div class="bubble-doc-actions">
                                                <a href="${med.url}" target="_blank" class="btn-doc-link">Open</a>
                                                <a href="${med.download_url}" class="btn-doc-link">Download</a>
                                            </div>
                                        </div>
                                    `;
                                }
                            }).join('') + `</div>`;
                        }

                        return `
                            <div class="bubble ${isSelf ? 'bubble-sent' : 'bubble-received'}">
                                ${!isSelf ? `<div style="font-size:11px; font-weight:600; color:var(--primary-accent); margin-bottom:2px;">${escapeHtml(m.user)}</div>` : ''}
                                ${m.text ? `<div>${escapeHtml(m.text)}</div>` : ''}
                                ${mediaHtml}
                                <div class="msg-meta" style="${isSelf ? 'justify-content:flex-end;' : ''}">${timeDisplay}</div>
                            </div>
                        `;
                    }).join('');
                    chatArea.scrollTop = chatArea.scrollHeight;
                } else {
                    if (data.message && data.message.includes('restricted')) {
                        chatArea.innerHTML = `<div style="text-align:center; padding:30px; color:var(--danger-red); font-size:12px;">${escapeHtml(data.message)}</div>`;
                    }
                }
            } catch (e) {
                console.error(e);
            }
        }

        function renderLockedChannelBanner() {
            chatArea.innerHTML = `
                <div class="locked-channel-banner">
                    <div class="locked-channel-banner-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </div>
                    <h3 style="font-size: 15px; font-weight: 600; margin-bottom: 6px; color: var(--text-primary);">Channel Protected</h3>
                    <p style="font-size: 12px; color: var(--text-secondary); margin-bottom: 18px; line-height: 1.45;">
                        This channel is locked. Conversation history, files, and messaging are encrypted until unlocked with the 4-character passcode.
                    </p>
                    <button class="btn btn-primary" onclick="openUnlockModal()" style="font-size: 12px; padding: 6px 16px;">
                        Enter Passcode
                    </button>
                </div>
            `;
        }

        /* ── File Selection & Attachment Handling ───────────────────────────── */
        function handleFilesSelected(files) {
            if (!files || files.length === 0) return;
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                if (file.size > 25 * 1024 * 1024) {
                    alert(`File "${file.name}" exceeds the 25MB upload limit.`);
                    continue;
                }
                pendingFiles.push(file);
            }
            renderAttachmentPreviews();
        }

        function removePendingFile(index) {
            pendingFiles.splice(index, 1);
            renderAttachmentPreviews();
        }

        function renderAttachmentPreviews() {
            const previewArea = document.getElementById('attachmentPreviewArea');
            if (pendingFiles.length === 0) {
                previewArea.style.display = 'none';
                previewArea.innerHTML = '';
                return;
            }

            previewArea.style.display = 'flex';
            previewArea.innerHTML = pendingFiles.map((f, idx) => `
                <div class="attachment-pill">
                    <span class="attachment-pill-name">📎 ${escapeHtml(f.name)} (${(f.size / 1024).toFixed(0)} KB)</span>
                    <span class="attachment-pill-remove" onclick="removePendingFile(${idx})" title="Remove">✕</span>
                </div>
            `).join('');
        }

        /* ── Send Message & Media ───────────────────────────────────────────── */
        if (sendChatBtn) {
            sendChatBtn.onclick = async () => {
                const text = chatInput.value.trim();
                if (!text && pendingFiles.length === 0) return;
                if (!currentProjectId) {
                    alert('Please select a channel first');
                    return;
                }

                if (currentProjectIsLocked && !currentProjectIsUnlocked) {
                    openUnlockModal();
                    return;
                }

                try {
                    let res;
                    if (pendingFiles.length > 0) {
                        const formData = new FormData();
                        formData.append('project', currentProjectId);
                        formData.append('text', text);
                        for (let i = 0; i < pendingFiles.length; i++) {
                            formData.append('files', pendingFiles[i]);
                        }

                        res = await fetch('/api/chat/messages/', {
                            method: 'POST',
                            body: formData
                        });
                    } else {
                        res = await fetch('/api/chat/messages/', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ project: currentProjectId, text: text })
                        });
                    }

                    const data = await res.json();
                    if (data.status === 'ok') {
                        chatInput.value = '';
                        pendingFiles = [];
                        renderAttachmentPreviews();
                        loadMessages();
                    } else if (data.status === 'locked') {
                        currentProjectIsUnlocked = false;
                        openUnlockModal();
                    } else {
                        alert(data.message || 'Error sending message');
                    }
                } catch (e) {
                    alert('Connection error. Please try again.');
                }
            };
        }

        if (chatInput) {
            chatInput.onkeypress = (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    sendChatBtn.click();
                }
            };
        }

        /* ── 4-Character Hex Unlock Modal Logic ────────────────────────────── */
        const unlockModal = document.getElementById('unlockModal');
        const hexInputs = [
            document.getElementById('hexDigit0'),
            document.getElementById('hexDigit1'),
            document.getElementById('hexDigit2'),
            document.getElementById('hexDigit3')
        ];

        function openUnlockModal() {
            document.getElementById('unlockChannelSubtitle').textContent = `# ${currentProjectName} passcode`;
            document.getElementById('unlockErrorMsg').style.display = 'none';
            hexInputs.forEach(input => input.value = '');
            unlockModal.classList.add('active');
            setTimeout(() => hexInputs[0].focus(), 50);
        }

        function closeUnlockModal() {
            unlockModal.classList.remove('active');
        }

        hexInputs.forEach((input, index) => {
            input.addEventListener('input', (e) => {
                const val = e.target.value;
                // Allow only hex chars 0-9, A-F
                const clean = val.replace(/[^0-9a-fA-F]/g, '').toUpperCase();
                input.value = clean.slice(-1);

                if (clean && index < 3) {
                    hexInputs[index + 1].focus();
                }
                if (index === 3 && hexInputs.every(i => i.value.length === 1)) {
                    submitPasscodeUnlock();
                }
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !input.value && index > 0) {
                    hexInputs[index - 1].focus();
                } else if (e.key === 'Enter') {
                    submitPasscodeUnlock();
                }
            });

            input.addEventListener('paste', (e) => {
                e.preventDefault();
                const pasteData = (e.clipboardData || window.clipboardData).getData('text');
                const clean = pasteData.replace(/[^0-9a-fA-F]/g, '').toUpperCase();
                for (let i = 0; i < Math.min(clean.length, 4); i++) {
                    hexInputs[i].value = clean[i];
                }
                if (clean.length >= 4) {
                    hexInputs[3].focus();
                    submitPasscodeUnlock();
                } else if (clean.length > 0) {
                    hexInputs[Math.min(clean.length, 3)].focus();
                }
            });
        });

        async function submitPasscodeUnlock() {
            const code = hexInputs.map(i => i.value).join('');
            const errorElem = document.getElementById('unlockErrorMsg');

            if (code.length !== 4 || !/^[0-9A-Fa-f]{4}$/.test(code)) {
                errorElem.textContent = 'Please enter a 4-character hexadecimal passcode (0-9, A-F).';
                errorElem.style.display = 'block';
                return;
            }

            errorElem.style.display = 'none';
            try {
                const res = await fetch(`/api/chat/unlock/${encodeURIComponent(currentProjectId)}/`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ passcode: code })
                });
                const data = await res.json();

                if (data.status === 'ok') {
                    currentProjectIsUnlocked = true;
                    closeUnlockModal();
                    
                    // Update active channel item lock icon in sidebar
                    const activeElem = document.querySelector(`.channel-item[data-id="${currentProjectId}"]`);
                    if (activeElem) {
                        activeElem.setAttribute('data-unlocked', 'true');
                        const lockIcon = activeElem.querySelector('.channel-lock-icon');
                        if (lockIcon) {
                            lockIcon.className = 'channel-lock-icon unlocked';
                            lockIcon.title = 'Unlocked for this session';
                            lockIcon.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 9.9-1"></path></svg>`;
                        }
                    }

                    updateHeaderLockState();
                    loadMessages();
                } else {
                    errorElem.textContent = data.message || 'Incorrect passcode. Access denied.';
                    errorElem.style.display = 'block';
                    hexInputs.forEach(i => i.value = '');
                    hexInputs[0].focus();
                }
            } catch (e) {
                errorElem.textContent = 'Network error while verifying passcode.';
                errorElem.style.display = 'block';
            }
        }

        /* ── Admin Lock Settings Modal Logic ───────────────────────────────── */
        const lockSettingsModal = document.getElementById('lockSettingsModal');
        const enableLockCheckbox = document.getElementById('enableLockCheckbox');
        const lockPasscodeConfigSection = document.getElementById('lockPasscodeConfigSection');
        const adminPasscodeInput = document.getElementById('adminPasscodeInput');
        const lockSettingsErrorMsg = document.getElementById('lockSettingsErrorMsg');

        function toggleLockInputs(enabled) {
            lockPasscodeConfigSection.style.display = enabled ? 'block' : 'none';
        }

        async function openLockSettingsModal() {
            if (!currentProjectId) return;
            document.getElementById('settingsChannelName').textContent = `# ${currentProjectName} access settings`;
            lockSettingsErrorMsg.style.display = 'none';

            try {
                const res = await fetch(`/api/chat/lock-settings/${encodeURIComponent(currentProjectId)}/`);
                const data = await res.json();
                if (data.status === 'ok') {
                    enableLockCheckbox.checked = !!data.is_locked;
                    toggleLockInputs(data.is_locked);
                    adminPasscodeInput.value = '';
                    lockSettingsModal.classList.add('active');
                } else {
                    alert(data.message || 'Error fetching channel settings');
                }
            } catch (e) {
                alert('Connection error');
            }
        }

        function closeLockSettingsModal() {
            lockSettingsModal.classList.remove('active');
        }

        async function saveChannelLockSettings() {
            const isLocked = enableLockCheckbox.checked;
            const passcode = adminPasscodeInput.value.trim().toUpperCase();

            if (isLocked && passcode && !/^[0-9A-F]{4}$/.test(passcode)) {
                lockSettingsErrorMsg.textContent = 'Passcode must be exactly 4 hexadecimal characters (0-9, A-F).';
                lockSettingsErrorMsg.style.display = 'block';
                return;
            }

            lockSettingsErrorMsg.style.display = 'none';

            try {
                const res = await fetch(`/api/chat/lock-settings/${encodeURIComponent(currentProjectId)}/`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ is_locked: isLocked, passcode: passcode })
                });
                const data = await res.json();

                if (data.status === 'ok') {
                    currentProjectIsLocked = data.is_locked;
                    if (data.is_locked) {
                        currentProjectIsUnlocked = true;
                    }
                    closeLockSettingsModal();
                    
                    // Reload channel list metadata or update active DOM item
                    const activeElem = document.querySelector(`.channel-item[data-id="${currentProjectId}"]`);
                    if (activeElem) {
                        activeElem.setAttribute('data-locked', data.is_locked ? 'true' : 'false');
                        const rightContainer = activeElem.querySelector('.channel-item-right');
                        let lockIcon = activeElem.querySelector('.channel-lock-icon');
                        
                        if (data.is_locked) {
                            if (!lockIcon) {
                                lockIcon = document.createElement('span');
                                rightContainer.insertBefore(lockIcon, rightContainer.firstChild);
                            }
                            lockIcon.className = 'channel-lock-icon unlocked';
                            lockIcon.title = 'Unlocked for this session';
                            lockIcon.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 9.9-1"></path></svg>`;
                        } else {
                            if (lockIcon) lockIcon.remove();
                        }
                    }

                    updateHeaderLockState();
                    loadMessages();
                } else {
                    lockSettingsErrorMsg.textContent = data.message || 'Error saving settings';
                    lockSettingsErrorMsg.style.display = 'block';
                }
            } catch (e) {
                lockSettingsErrorMsg.textContent = 'Network error while updating lock settings.';
                lockSettingsErrorMsg.style.display = 'block';
            }
        }

        /* ── Image Lightbox Modal ───────────────────────────────────────────── */
        const lightboxModal = document.getElementById('imageLightboxModal');
        const lightboxImg = document.getElementById('lightboxImg');
        const lightboxDownloadBtn = document.getElementById('lightboxDownloadBtn');

        function openLightbox(url, filename) {
            lightboxImg.src = url;
            lightboxDownloadBtn.href = url + (url.includes('?') ? '&' : '?') + 'download=1';
            lightboxDownloadBtn.setAttribute('download', filename || 'image');
            lightboxModal.classList.add('active');
        }

        function closeLightbox(event, force) {
            if (force || (event && event.target === lightboxModal)) {
                lightboxModal.classList.remove('active');
            }
        }

        /* ── Initial Load & Auto-polling ────────────────────────────────────── */
        if (currentProjectId) {
            updateHeaderLockState();
            loadMessages();
            pollingInterval = setInterval(loadMessages, 4000);
        }
    </script>
</body>

</html>