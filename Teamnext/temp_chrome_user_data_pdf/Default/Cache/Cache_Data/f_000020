                            </div>
                        </div>

                        <div style="background:#FAFBFD; padding:14px; border-radius:8px; border:1px solid var(--border-subtle);">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 6px; font-size: 12px; font-weight: 500;">
                                <span>Pantry Coffee & Refreshments</span>
                                <span style="color: var(--success-green); font-weight: 600;">80% remaining</span>
                            </div>
                            <div style="height: 6px; background: #E2E8F0; border-radius: 4px; overflow: hidden;">
                                <div style="width: 80%; height: 100%; background: var(--success-green);"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal for Adding Asset -->
    <div id="assetModal" class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <span class="modal-title">Register New Enterprise Asset</span>
                <button type="button" class="btn btn-ghost btn-sm" onclick="closeAssetModal()">✕</button>
            </div>
            <div class="modal-body">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div class="form-group">
                        <label>Asset Model / Name *</label>
                        <input type="text" id="assetName" placeholder="e.g. MacBook Pro 16">
                    </div>
                    <div class="form-group">
                        <label>Serial Number / Asset Tag *</label>
                        <input type="text" id="assetSerial" placeholder="e.g. AAPL-8839">
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Hardware Category</label>
                            <select id="assetCategory">
                                <option value="Computing">Computing</option>
                                <option value="Display">Display / Monitors</option>
                                <option value="Mobile">Mobile / Tablets</option>
                                <option value="Furniture">Furniture</option>
                                <option value="Other">Other Equipment</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Operational Status</label>
                            <select id="assetStatus">
                                <option value="Active">Active</option>
                                <option value="In Stock">In Stock</option>
                                <option value="Repair">Under Repair</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Assigned Custodian (Name or Email)</label>
                        <input type="text" id="allottedTo" placeholder="e.g. alex@company.com">
                    </div>
                </div>
                <div id="assetMsg" style="margin-top: 10px; text-align: center; font-size: 12px; min-height: 14px;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeAssetModal()">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmAssetBtn">Save Asset</button>
            </div>
        </div>
    </div>

    <script>
        const assetModal = document.getElementById('assetModal');
        const assetMsg = document.getElementById('assetMsg');

        document.getElementById('addAssetBtn').onclick = () => {
            assetModal.classList.add('active');
            assetMsg.textContent = '';
        };

        function closeAssetModal() {
            assetModal.classList.remove('active');
        }

        document.getElementById('confirmAssetBtn').onclick = async () => {
            const name = document.getElementById('assetName').value.trim();
            const serial = document.getElementById('assetSerial').value.trim();
            const category = document.getElementById('assetCategory').value;
            const allotted = document.getElementById('allottedTo').value.trim();
            const status = document.getElementById('assetStatus').value;

            if (!name || !serial) return alert('Name and Serial Number are required');

            assetMsg.textContent = 'Registering asset...';
            assetMsg.style.color = 'var(--text-muted)';
            try {
                const res = await fetch('/api/inventory/add-asset/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, serial, category, allotted, status })
                });
                const data = await res.json();
                if (data.status === 'ok') {
                    assetMsg.textContent = 'Asset registered successfully!';
                    assetMsg.style.color = 'var(--success-green)';
                    setTimeout(() => {
                        closeAssetModal();
                        location.reload();
                    }, 1000);
                } else {
                    assetMsg.textContent = data.message || 'Error saving asset';
                    assetMsg.style.color = 'var(--danger-red)';
                }
            } catch (e) {
                assetMsg.textContent = 'Connection error';
                assetMsg.style.color = 'var(--danger-red)';
            }
        };
    </script>
</body>

</html>