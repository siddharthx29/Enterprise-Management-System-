                        </div>
                        <button class="btn btn-primary" onclick="createProject()" style="display: inline-flex; align-items: center; gap: 6px;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            <span>Launch Project</span>
                        </button>
                    </div>
                </div>
            </div>
            

            <!-- Structure Grid -->
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                        </svg>
                        <span>Organizational Structure & Active Projects</span>
                    </span>
                </div>
                <div class="panel-body">
                    <div id="contentGrid" class="dept-grid">
                        <!-- Populated by JS -->
                    </div>

                    <div id="unassignedProjects" style="display: none; margin-top: 20px; padding-top: 16px; border-top: 1px dashed var(--border-color);">
                        <div style="font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 8px;">Standalone / Direct Projects</div>
                        <ul id="unassignedList" class="proj-list" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 8px;"></ul>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        let departments = [];
        let projects = [];

        async function loadData() {
            try {
                const [dRes, pRes] = await Promise.all([
                    fetch('/api/departments/'),
                    fetch('/api/projects/')
                ]);
                const [dData, pData] = await Promise.all([dRes.json(), pRes.json()]);

                if (dData.status === 'ok') departments = dData.departments;
                if (pData.status === 'ok') projects = pData.projects;

                renderInterface();
            } catch (e) {
                console.error(e);
            }
        }

        function renderInterface() {
            const grid = document.getElementById('contentGrid');
            grid.innerHTML = '';

            const picker = document.getElementById('deptPicker');
            if (picker) {
                picker.innerHTML = departments.map(d => `<div class="multi-item" data-id="${d.id}" onclick="this.classList.toggle('selected')">${d.name}</div>`).join('');
            }

            if (departments.length === 0) {
                grid.innerHTML = '<div style="grid-column: 1/-1; text-align: center; padding: 32px; color: var(--text-muted); font-size: 12px;">No departments registered yet.</div>';
                return;
            }

            departments.forEach(dept => {
                const deptProjects = projects.filter(p => p.departments.some(pd => pd.id === dept.id));
                const card = document.createElement('div');
                card.className = 'dept-card';
                card.innerHTML = `
                    <div class="dept-header">
                        <span class="dept-name">${dept.name}</span>
                        <span class="badge badge-gray">${deptProjects.length} Projects</span>
                    </div>
                    <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 12px;">${dept.desc || 'No description provided.'}</div>
                    <ul class="proj-list">
                        ${deptProjects.length > 0 ? deptProjects.map(p => `
                            <li class="proj-item">
                                <span style="font-weight: 500; color: var(--text-primary);">${p.name}</span>
                                <span class="badge badge-blue">Active</span>
                            </li>
                        `).join('') : '<li style="font-size: 11px; color: var(--text-muted); font-style: italic;">No active projects</li>'}
                    </ul>
                `;
                grid.appendChild(card);
            });

            // Unassigned
            const unassigned = projects.filter(p => !p.departments || p.departments.length === 0);
            const unSection = document.getElementById('unassignedProjects');
            const unList = document.getElementById('unassignedList');
            if (unassigned.length > 0) {
                unSection.style.display = 'block';
                unList.innerHTML = unassigned.map(p => `
                    <li class="proj-item">
                        <span style="font-weight: 500; color: var(--text-primary);">${p.name}</span>
                        <span class="badge badge-amber">Direct</span>
                    </li>
                `).join('');
            } else {
                unSection.style.display = 'none';
            }
        }

        async function createDepartment() {
            const name = document.getElementById('newDeptName').value.trim();
            const desc = document.getElementById('newDeptDesc').value.trim();
            if (!name) return alert('Department name required');

            const res = await fetch('/api/departments/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, desc })
            });
            if ((await res.json()).status === 'ok') {
                document.getElementById('newDeptName').value = '';
                document.getElementById('newDeptDesc').value = '';
                loadData();
            }
        }

        async function createProject() {
            const name = document.getElementById('newProjName').value.trim();
            const desc = document.getElementById('newProjDesc').value.trim();
            const deptIds = Array.from(document.querySelectorAll('#deptPicker .multi-item.selected')).map(el => el.dataset.id);

            if (!name) return alert('Project name required');

            const res = await fetch('/api/projects/add/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, desc, departments: deptIds })
            });
            if ((await res.json()).status === 'ok') {
                document.getElementById('newProjName').value = '';
                document.getElementById('newProjDesc').value = '';
                loadData();
            }
        }

        loadData();
    </script>
</body>

</html>