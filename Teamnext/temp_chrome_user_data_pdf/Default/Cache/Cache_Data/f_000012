                            </div>
                        </div>
                        <p style="font-size: 11px; color: var(--text-muted); margin-top: 12px;">
                            * Calculated dynamically based on 18% standard GST taxation bracket.
                        </p>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <span class="panel-title">Account Reconciliation & Reporting</span>
                    </div>
                    <div class="panel-body">
                        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                            <button class="btn btn-primary" onclick="reconcileBank()">Sync Bank Statements</button>
                            <button class="btn btn-ghost" onclick="generateReport('tax')">Generate Tax Report (PDF)</button>
                            <button class="btn btn-ghost" onclick="exportFinance('pdf')">Export Balance Sheet</button>
                        </div>
                        <div id="statusMsg" style="margin-top: 14px; font-size: 12px; min-height: 16px;"></div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal for Finance Actions -->
    <div id="financeModal" class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <span class="modal-title" id="modalTitle">Finance Action</span>
                <button type="button" class="btn btn-ghost btn-sm" onclick="closeModal()">✕</button>
            </div>
            <div class="modal-body">
                <div id="modalFields" style="display: flex; flex-direction: column; gap: 12px;">
                    <div id="field1Container">
                        <label id="label1">Entity / Vendor Name</label>
                        <input type="text" id="field1" placeholder="Client or Vendor Name">
                    </div>
                    <div id="field2Container">
                        <label id="label2">Amount ($)</label>
                        <input type="number" id="field2" placeholder="0.00" step="0.01">
                    </div>
                    <div id="gstFieldContainer" style="display: none;">
                        <label>GST Rate (%)</label>
                        <select id="gstRate">
                            <option value="0">0% (Nil)</option>
                            <option value="5">5% (Essential)</option>
                            <option value="12">12% (Standard Low)</option>
                            <option value="18" selected>18% (Standard)</option>
                            <option value="28">28% (Luxury)</option>
                        </select>
                    </div>
                    <div id="categoryFieldContainer" style="display: none;">
                        <label>Expense Category</label>
                        <input type="text" id="expenseCategory" placeholder="e.g. Marketing, Cloud Infrastructure, Rent">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal()">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmActionBtn">Confirm & Save</button>
            </div>
        </div>
    </div>

    <script>
        const modal = document.getElementById('financeModal');
        const modalTitle = document.getElementById('modalTitle');
        const field1 = document.getElementById('field1');
        const field2 = document.getElementById('field2');
        const label1 = document.getElementById('label1');
        const label2 = document.getElementById('label2');
        const statusMsg = document.getElementById('statusMsg');

        const gstContainer = document.getElementById('gstFieldContainer');
        const categoryContainer = document.getElementById('categoryFieldContainer');

        let currentAction = '';

        async function loadFinanceData() {
            try {
                const res = await fetch('/api/finance/data/');
                const data = await res.json();
                if (data.status === 'ok') {
                    document.getElementById('stat-revenue').textContent = '$' + data.revenue.toLocaleString();
                    document.getElementById('stat-expenses').textContent = '$' + data.expenses.toLocaleString();
                    document.getElementById('stat-payroll').textContent = '$' + data.payroll.toLocaleString();

                    const tbody = document.getElementById('transactionTableBody');
                    tbody.innerHTML = '';
                    if (data.recent.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:24px; color:var(--text-muted);">No transactions recorded.</td></tr>';
                    } else {
                        data.recent.forEach(txn => {
                            const tr = document.createElement('tr');
                            const isPaid = (txn.status || '').toLowerCase() === 'paid';
                            tr.innerHTML = `
                                <td>${txn.date}</td>
                                <td><span class="badge badge-gray">${txn.type}</span></td>
                                <td style="font-weight:600; color:var(--text-primary);">${txn.entity}</td>
                                <td style="font-weight:600;">$${txn.amount.toLocaleString()}</td>
                                <td><span class="badge ${isPaid ? 'badge-green' : 'badge-amber'}">${txn.status}</span></td>
                            `;
                            tbody.appendChild(tr);
                        });
                    }

                    document.getElementById('payable-gst').textContent = '$' + (data.revenue * 0.18).toLocaleString();
                }
            } catch (e) {
                console.error('Data load error', e);
            }
        }

        function openModal(action, title, l1, l2) {
            currentAction = action;
            modalTitle.textContent = title;
            label1.textContent = l1;
            label2.textContent = l2;
            field1.value = '';
            field2.value = '';

            gstContainer.style.display = action === 'invoice' ? 'block' : 'none';
            categoryContainer.style.display = action === 'expense' ? 'block' : 'none';

            modal.classList.add('active');
        }

        function closeModal() {
            modal.classList.remove('active');
        }

        document.getElementById('createInvoiceBtn').onclick = () => openModal('invoice', 'Create New Invoice', 'Client Name', 'Base Amount ($)');
        document.getElementById('logExpenseBtn').onclick = () => openModal('expense', 'Log Business Expense', 'Description', 'Amount ($)');
        document.getElementById('payoutSalaryBtn').onclick = () => openModal('salary', 'Salary Payout Record', 'Employee Name', 'Net Salary ($)');
        document.getElementById('addBillBtn').onclick = () => openModal('bill', 'Register New Bill', 'Vendor Name', 'Bill Amount ($)');

        document.getElementById('confirmActionBtn').onclick = async () => {
            const val1 = field1.value.trim();
            const val2 = field2.value.trim();
            if (!val1 || !val2) return alert('Please fill all fields');

            const urls = {
                'invoice': '/api/finance/invoice/',
                'expense': '/api/finance/expense/',
                'salary': '/api/finance/salary/',
                'bill': '/api/finance/bill/'
            };

            const bodyData = {
                entity: val1,
                amount: val2
            };

            if (currentAction === 'invoice') bodyData.gst_rate = document.getElementById('gstRate').value;
            if (currentAction === 'expense') bodyData.category = document.getElementById('expenseCategory').value;

            try {
                const res = await fetch(urls[currentAction], {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(bodyData)
                });
                const data = await res.json();
                if (data.status === 'ok') {
                    statusMsg.textContent = data.message;
                    statusMsg.style.color = 'var(--success-green)';
                    closeModal();
                    loadFinanceData();
                    setTimeout(() => statusMsg.textContent = '', 4000);
                } else {
                    alert(data.message || 'Error occurred');
                }
            } catch (e) {
                alert('Connection error');
            }
        };

        function exportFinance(format) {
            window.location.href = `/api/finance/export/?format=${format}`;
        }

        async function generateReport(type) {
            statusMsg.textContent = `Generating ${type} report...`;
            statusMsg.style.color = 'var(--primary-accent)';
            try {
                const res = await fetch('/api/reports/generate/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ report_type: type, format: 'pdf' })
                });
                const data = await res.json();
                if (data.status === 'ok') {
                    const blob = b64toBlob(data.file_data, data.content_type);
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `${type}_Statement.pdf`;
                    a.click();
                    statusMsg.textContent = 'Report generated!';
                    statusMsg.style.color = 'var(--success-green)';
                }
            } catch (e) {
                statusMsg.textContent = 'Error generating report';
                statusMsg.style.color = 'var(--danger-red)';
            }
        }

        function reconcileBank() {
            alert('Bank reconciliation module activated. Syncing ledger with corporate bank feed...');
        }

        function b64toBlob(b64Data, contentType = '', sliceSize = 512) {
            const byteCharacters = atob(b64Data);
            const byteArrays = [];
            for (let offset = 0; offset < byteCharacters.length; offset += sliceSize) {
                const slice = byteCharacters.slice(offset, offset + sliceSize);
                const byteNumbers = new Array(slice.length);
                for (let i = 0; i < slice.length; i++) {
                    byteNumbers[i] = slice.charCodeAt(i);
                }
                const byteArray = new Uint8Array(byteNumbers);
                byteArrays.push(byteArray);
            }
            return new Blob(byteArrays, { type: contentType });
        }

        window.onload = loadFinanceData;
    </script>
</body>

</html>