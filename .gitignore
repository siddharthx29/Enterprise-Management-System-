# ============================================================
# Git Ignore Rules for TeamNext Enterprise ERP
# ============================================================

# Environment and Secret Files
.env
.env.*
!.env.example
*.env
**/.env

# SQLite Database & Local Data
*.sqlite3
*.db
db.sqlite3
Teamnext/db.sqlite3

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Static and media directories
staticfiles/
Teamnext/staticfiles/
media/
Teamnext/media/

# Virtual Environments
venv/
env/
ENV/
.venv/

# IDE and Editor configs
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and Session dumps
*.log
logs/
*.out
